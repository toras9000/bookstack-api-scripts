#!/usr/bin/env -S dotnet run --file
#:package MySqlConnector@2.6.0
#:package BCrypt.Net-Next@4.2.0
#:package Lestaly.General@0.136.0
#:package RefFile@0.2.0
using System.Data;
using Lestaly;
using MySqlConnector;
[assembly: RefFile(".settings.cs1")]

return await Paved.ProceedAsync(noPause: args.RoughContains("--no-pause"), async () =>
{
    Console.WriteLine("Prepare db connection ...");
    var settings = new Settings(ThisSource.Directory());
    var config = new MySqlConnectionStringBuilder();
    config.Server = settings.Database.Host;
    config.Port = settings.Database.Port;
    config.UserID = settings.Database.Username;
    config.Password = settings.Database.Password;
    config.Database = settings.Database.Database;
    using var mysql = new MySqlConnection(config.ConnectionString);
    await mysql.OpenAsync();

    var tokenUser = "Admin";
    var tokenName = settings.BookStack.Api.TokenName;
    var tokenId = settings.BookStack.Api.TokenId;
    var tokenSecret = settings.BookStack.Api.TokenSecret;

    Console.WriteLine("Get user id ...");
    var tokenUserId = default(uint?);
    using (var command = mysql.CreateCommand())
    {
        command.CommandType = CommandType.Text;
        command.CommandText = "select id from users where name = @user";
        command.Parameters.Add(new MySqlParameter("user", tokenUser));

        tokenUserId = (uint?)await command.ExecuteScalarAsync() ?? throw new Exception($"User '{tokenUser}' not found");
    }
    Console.WriteLine($".. User: {tokenUser} [{tokenUserId}]");

    Console.WriteLine("Check token id ...");
    var existingTokens = new List<UserToken>();
    using (var command = mysql.CreateCommand())
    {
        command.CommandType = CommandType.Text;
        command.CommandText = "select user_id, token_id from api_tokens where user_id = @user_id or token_id = @token_id";
        command.Parameters.Add(new MySqlParameter("user_id", tokenUserId));
        command.Parameters.Add(new MySqlParameter("token_id", tokenId));

        using var reader = await command.ExecuteReaderAsync();
        while (await reader.ReadAsync())
        {
            var userID = reader.GetUInt32("user_id");
            var tokenID = reader.GetString("token_id");
            existingTokens.Add(new(userID, tokenID));
        }
    }
    if (existingTokens.Any(t => t.TokenID == tokenId))
    {
        var satisfy = existingTokens.Any(t => t.TokenID == tokenId && t.UserID == tokenUserId);
        if (!satisfy) throw new Exception("Duplicate token ID for other user");
        Console.WriteLine(".. Already exists");
        return;
    }
    Console.WriteLine(".. Not exists");

    Console.WriteLine("Create api token ...");
    var hashSalt = BCrypt.Net.BCrypt.GenerateSalt(12, 'y');
    var secretHash = BCrypt.Net.BCrypt.HashPassword(tokenSecret, hashSalt);
    using (var command = mysql.CreateCommand())
    {
        command.CommandType = CommandType.Text;
        command.CommandText = "insert into api_tokens (name, user_id, token_id, secret, expires_at) values (@name, @user_id, @token_id, @secret, @expires_at)";
        command.Parameters.Add(new MySqlParameter("name", tokenName));
        command.Parameters.Add(new MySqlParameter("user_id", tokenUserId));
        command.Parameters.Add(new MySqlParameter("token_id", tokenId));
        command.Parameters.Add(new MySqlParameter("secret", secretHash));
        command.Parameters.Add(new MySqlParameter("expires_at", DateTime.Now.AddYears(100)));

        await command.ExecuteNonQueryAsync();
    }
    Console.WriteLine(".. Token created");
});

record struct UserToken(uint UserID, string TokenID);
