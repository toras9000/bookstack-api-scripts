#!/usr/bin/env -S dotnet run --file
#:package Lestaly.General@0.147.0
using Lestaly;
using Lestaly.Cx;

return await Paved.ProceedAsync(async () =>
{
    await "dotnet".args("run", "--file", ThisSource.RelativeFile("01.delete-data.cs2"), "--no-pause").echo().result().success();
    await "dotnet".args("run", "--file", ThisSource.RelativeFile("10.restart-containers.cs2"), "--no-pause").echo().result().success();
    await "dotnet".args("run", "--file", ThisSource.RelativeFile("11.meke-api-token.cs2"), "--no-pause").echo().result().success();
    await "dotnet".args("run", "--file", ThisSource.RelativeFile("80-create-dummy-entities.cs2"), "--no-pause").echo().result().success();
    await "dotnet".args("run", "--file", ThisSource.RelativeFile("@show-service.cs2"), "--no-pause").echo().result().success();
});
